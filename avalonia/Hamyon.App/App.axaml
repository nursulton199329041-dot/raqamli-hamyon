<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hamyon.App.ViewModels"
             xmlns:views="using:Hamyon.App.Views"
             xmlns:conv="using:Hamyon.App.Converters"
             x:Class="Hamyon.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <conv:BadgeBrushConverter x:Key="BadgeBrush" />
    <conv:GlowConverter x:Key="Glow" />
    <conv:HexBrushConverter x:Key="HexBrush" />
    <conv:ShareWidthConverter x:Key="ShareWidth" />
    <conv:InkOnConverter x:Key="InkOn" />
    <conv:InkOnHexConverter x:Key="InkOnHex" />
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:OperationViewModel"><views:OperationView /></DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel"><views:HistoryView /></DataTemplate>
    <DataTemplate DataType="vm:ReportsViewModel"><views:ReportsView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:CatalogViewModel"><views:CatalogView /></DataTemplate>
    <DataTemplate DataType="vm:EditorViewModel"><views:EditorView /></DataTemplate>
    <DataTemplate DataType="vm:DebtsViewModel"><views:DebtsView /></DataTemplate>
    <DataTemplate DataType="vm:ProfilesViewModel"><views:ProfilesView /></DataTemplate>
    <DataTemplate DataType="vm:ItemViewModel"><views:ItemView /></DataTemplate>
    <DataTemplate DataType="vm:LockViewModel"><views:LockView /></DataTemplate>
    <DataTemplate DataType="vm:ExportViewModel"><views:ExportView /></DataTemplate>
    <DataTemplate DataType="vm:AccountViewModel"><views:AccountView /></DataTemplate>
    <DataTemplate DataType="vm:PeriodPickerViewModel"><views:PeriodPickerView /></DataTemplate>
    <DataTemplate DataType="vm:BudgetViewModel"><views:BudgetView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Hamyon.App/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
