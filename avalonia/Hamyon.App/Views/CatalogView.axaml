<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Hamyon.App.Localization"
             xmlns:vm="using:Hamyon.App.ViewModels"
             xmlns:c="using:Hamyon.App.Controls"
             x:Class="Hamyon.App.Views.CatalogView"
             x:DataType="vm:CatalogViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,12,16,120" Spacing="12" MaxWidth="600">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
        <Button Classes="flat" Command="{Binding GoBackCommand}">
          <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource GlassBrush}">
            <c:Glyph Kind="chevronLeft" Foreground="{DynamicResource AccentBrush}" Width="20" Height="20" />
          </Border>
        </Button>
        <TextBlock Grid.Column="1" Classes="label" Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="13.5"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="flat" Command="{Binding AddCommand}">
          <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentBrush}">
            <c:Glyph Kind="plus" Foreground="{Binding $parent[Border].Background, Converter={StaticResource InkOn}}" Width="20" Height="20" Thickness="2.2" />
          </Border>
        </Button>
      </Grid>

      <Border Classes="card" Padding="8,4">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChoiceVm">
              <Button Classes="flat" Command="{Binding $parent[UserControl].((vm:CatalogViewModel)DataContext).EditCommand}" CommandParameter="{Binding}">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,10" Background="Transparent">
                  <Border Width="40" Height="40" CornerRadius="20" Background="{Binding Color, Converter={StaticResource BadgeBrush}}">
                    <c:Glyph Kind="{Binding Icon}" Foreground="White" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Hint}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <c:Glyph Grid.Column="2" Kind="edit" Foreground="{StaticResource TextSecondaryBrush}" Width="18" Height="18" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
