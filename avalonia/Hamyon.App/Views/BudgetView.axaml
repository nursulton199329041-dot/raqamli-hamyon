<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Hamyon.App.Localization"
             xmlns:vm="using:Hamyon.App.ViewModels"
             xmlns:c="using:Hamyon.App.Controls"
             x:Class="Hamyon.App.Views.BudgetView"
             x:DataType="vm:BudgetViewModel">
  <Border Background="{DynamicResource SheetBrush}" CornerRadius="30,30,0,0" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1,1,1,0"
          BoxShadow="0 -12 40 0 #80000000" MaxHeight="760">
    <Grid RowDefinitions="Auto,*,Auto" Margin="18,10,18,22">
      <StackPanel Spacing="10">
        <Border Width="40" Height="5" CornerRadius="3" Background="#33FFECE4" HorizontalAlignment="Center" />
        <Grid ColumnDefinitions="40,*,Auto">
          <TextBlock Grid.Column="1" Text="{l:T budget_title}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="flat" Command="{Binding CloseCommand}">
            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource GlassStrongBrush}">
              <c:Glyph Kind="close" Foreground="{StaticResource TextBrush}" Width="18" Height="18" />
            </Border>
          </Button>
        </Grid>
        <TextBlock Text="{l:T budget_intro}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <ScrollViewer Grid.Row="1" Margin="0,10" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BudgetRowVm">
              <Grid ColumnDefinitions="Auto,*,130" Margin="0,6">
                <Border Width="42" Height="42" CornerRadius="21" Background="{Binding Color, Converter={StaticResource BadgeBrush}}">
                  <c:Glyph Kind="{Binding Icon}" Foreground="White" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding SpentText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBox Grid.Column="2" Text="{Binding Amount}" Watermark="{l:T budget_none}" CornerRadius="14" FontSize="15"
                         HorizontalContentAlignment="Right" TextInputOptions.ContentType="Number" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="label" Text="{l:T budget_total}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Total}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextBrush}" />
        </Grid>
        <Button Classes="flat" Command="{Binding SaveCommand}">
          <Border Height="52" CornerRadius="26" Background="{DynamicResource ActionBrush}">
            <TextBlock Classes="label" Text="{l:T save}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{Binding $parent[Border].Background, Converter={StaticResource InkOn}}" />
          </Border>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
