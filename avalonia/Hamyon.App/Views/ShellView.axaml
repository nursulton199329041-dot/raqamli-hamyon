<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Hamyon.App.Localization"
             xmlns:vm="using:Hamyon.App.ViewModels"
             xmlns:c="using:Hamyon.App.Controls"
             x:Class="Hamyon.App.Views.ShellView"
             x:DataType="vm:MainViewModel"
             x:Name="Root">
  <Grid>
    <!-- background: warm vertical gradient + garnet glow top-left + amber glow lower-right -->
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="20%,0%" EndPoint="50%,100%">
          <GradientStop Color="{StaticResource BgTop}" Offset="0" />
          <GradientStop Color="{StaticResource BgBottom}" Offset="0.75" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border>
      <Border.Background>
        <RadialGradientBrush Center="22%,14%" GradientOrigin="22%,14%" RadiusX="75%" RadiusY="45%">
          <GradientStop Color="#D98E1F2E" Offset="0" />
          <GradientStop Color="#008E1F2E" Offset="1" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border>
      <Border.Background>
        <RadialGradientBrush Center="88%,70%" GradientOrigin="88%,70%" RadiusX="60%" RadiusY="35%">
          <GradientStop Color="#59B4561C" Offset="0" />
          <GradientStop Color="#00B4561C" Offset="1" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <ContentControl Content="{Binding Current}" />

    <!-- bottom fade so content sinks behind the buttons -->
    <Border VerticalAlignment="Bottom" Height="140" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#000A0607" Offset="0" />
          <GradientStop Color="#E60A0607" Offset="0.55" />
          <GradientStop Color="#FF0A0607" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <!-- Liquid-glass tab bar: one glass capsule, a glass lens under the active tab. Tap a tab, or press anywhere on the
         bar and slide: the lens grows, follows the finger, magnifies the icons under it, and snaps to a tab on release.
         All pointer handling is in ShellView.axaml.cs. -->
    <Border x:Name="TabBar" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" MaxWidth="520" Margin="16,0,16,18"
            Height="68" CornerRadius="34" Padding="5" BorderThickness="1" BoxShadow="0 14 34 0 #8C000000">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#E6342027" Offset="0" />
          <GradientStop Color="#EB1A0E12" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#59FFFFFF" Offset="0" />
          <GradientStop Color="#14FFFFFF" Offset="1" />
        </LinearGradientBrush>
      </Border.BorderBrush>
      <Panel x:Name="TabArea" Background="Transparent" Cursor="Hand">
        <!-- the lens -->
        <Border x:Name="Lens" HorizontalAlignment="Left" CornerRadius="29" BorderThickness="1" IsHitTestVisible="False"
                BoxShadow="0 6 18 0 #59000000">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Color="#40FFFFFF" Offset="0" />
              <GradientStop Color="#1AFFFFFF" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Color="#80FFFFFF" Offset="0" />
              <GradientStop Color="#1FFFFFFF" Offset="1" />
            </LinearGradientBrush>
          </Border.BorderBrush>
          <Border.Transitions>
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32">
                <TransformOperationsTransition.Easing><CubicEaseOut /></TransformOperationsTransition.Easing>
              </TransformOperationsTransition>
              <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
            </Transitions>
          </Border.Transitions>
        </Border>
        <ItemsControl x:Name="TabItems" ItemsSource="{Binding Tabs}" IsHitTestVisible="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TabVm">
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center" Classes.on="{Binding IsActive}">
                <StackPanel.Styles>
                  <Style Selector="StackPanel > c|Glyph"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Style>
                  <Style Selector="StackPanel > TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" /></Style>
                  <Style Selector="StackPanel.on > c|Glyph"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
                  <Style Selector="StackPanel.on > TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
                </StackPanel.Styles>
                <c:Glyph Kind="{Binding Icon}" Width="23" Height="23" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </Border>

    <!-- bottom sheet: dimmed backdrop (tap closes) + the sheet itself -->
    <Panel IsVisible="{Binding Sheet, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Button Classes="flat" Command="{Binding CloseSheetCommand}">
        <Border Background="#A8080304" />
      </Button>
      <ContentControl Content="{Binding Sheet}" VerticalAlignment="Bottom" Margin="0,36,0,0" MaxWidth="600" />
    </Panel>

    <!-- app lock: above everything, the tab bar included -->
    <ContentControl Content="{Binding Lock}" IsVisible="{Binding Lock, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </Grid>
</UserControl>
