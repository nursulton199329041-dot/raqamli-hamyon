<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Hamyon.App.Localization"
             xmlns:vm="using:Hamyon.App.ViewModels"
             xmlns:c="using:Hamyon.App.Controls"
             x:Class="Hamyon.App.Views.OperationView"
             x:DataType="vm:OperationViewModel">
  <UserControl.Styles>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{StaticResource GlassBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="8,8,14,8" />
    </Style>
    <Style Selector="Border.chip.on">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Border.key">
      <Setter Property="Height" Value="56" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="#14FFECE4" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="ChoiceBody" x:DataType="vm:ChoiceVm">
      <Border Classes="chip" Classes.on="{Binding IsSelected}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="38" Height="38" CornerRadius="19" Background="{Binding Color, Converter={StaticResource BadgeBrush}}">
            <c:Glyph Kind="{Binding Icon}" Foreground="White" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="{Binding Hint}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Border Background="{DynamicResource SheetBrush}" CornerRadius="30,30,0,0" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1,1,1,0"
          BoxShadow="0 -12 40 0 #80000000">
    <DockPanel>
      <!-- header: grabber, kind pill, close -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="18,10,14,6" RowDefinitions="Auto,Auto">
        <Border Grid.ColumnSpan="2" Width="40" Height="5" CornerRadius="3" Background="#33FFECE4" HorizontalAlignment="Center" Margin="0,0,0,10" />
        <Border Grid.Row="1" CornerRadius="16" Padding="14,6" HorizontalAlignment="Left"
                Background="{Binding Color, Converter={StaticResource BadgeBrush}}">
          <TextBlock Classes="label" Text="{Binding Title}" Foreground="White" FontWeight="Bold" />
        </Border>
        <Button Grid.Row="1" Grid.Column="1" Classes="flat" Command="{Binding CloseCommand}">
          <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource GlassStrongBrush}">
            <c:Glyph Kind="close" Foreground="{StaticResource TextBrush}" Width="18" Height="18" />
          </Border>
        </Button>
      </Grid>

      <!-- error (not enough money, nothing chosen, …): right under the header, never hidden behind the keypad -->
      <Border DockPanel.Dock="Top" Margin="16,2,16,6" CornerRadius="16" Padding="14,10" Background="#33FF6B6B"
              BorderBrush="{StaticResource ExpenseBrush}" BorderThickness="1"
              IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*">
          <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource ExpenseBrush}" VerticalAlignment="Top">
            <TextBlock Text="!" FontWeight="Bold" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Grid.Column="1" Margin="10,3,0,0" Text="{Binding Error}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                     FontSize="14.5" TextWrapping="Wrap" />
        </Grid>
      </Border>

      <!-- keypad -->
      <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding KeyList}" Margin="10,4,10,14">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:KeyVm">
            <Button Classes="flat" Command="{Binding $parent[UserControl].((vm:OperationViewModel)DataContext).PressCommand}" CommandParameter="{Binding Text}">
              <Panel>
                <Border Classes="key" IsVisible="{Binding IsPlain}">
                  <TextBlock Text="{Binding Text}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <!-- ✓ = save (bottom-right) -->
                <Border Height="56" Margin="3" CornerRadius="16" Background="{c:Tint '#1FCB8B'}" BoxShadow="0 6 16 0 #4D000000"
                        IsVisible="{Binding IsDone}">
                  <c:Glyph Kind="check" Width="28" Height="28" Thickness="3" Foreground="White" />
                </Border>
              </Panel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,4,18,8" Spacing="12">
          <!-- amount; a dollar (non-so'm) expense shows the so'm side next to it with the rate under it -->
          <Grid ColumnDefinitions="*,Auto,*" IsVisible="{Binding NeedsRate}">
            <StackPanel Spacing="2" HorizontalAlignment="Stretch">
              <TextBlock Classes="label" Text="{l:T amount}" HorizontalAlignment="Center" />
              <Viewbox StretchDirection="DownOnly" Height="44">
                <TextBlock Classes="hero" Text="{Binding AmountText}" FontSize="34" />
              </Viewbox>
              <Border Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}" Margin="8,0" />
              <TextBlock Text="{Binding Expression}" IsVisible="{Binding ShowExpression}" HorizontalAlignment="Center"
                         Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource MonoFont}" />
            </StackPanel>
            <c:Glyph Grid.Column="1" Kind="chevronRight" Foreground="{StaticResource TextSecondaryBrush}" Width="20" Height="20" Thickness="2.4"
                     Margin="6,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Stretch">
              <TextBlock Classes="label" Text="{l:T amount_base}" HorizontalAlignment="Center" />
              <Viewbox StretchDirection="DownOnly" Height="44">
                <TextBlock Classes="hero" Text="{Binding BaseAmountText}" FontSize="34" Foreground="{StaticResource TextSecondaryBrush}" />
              </Viewbox>
              <!-- "100 USD × [12 650]" — the rate can be corrected right here -->
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding RateFormula}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBox Text="{Binding RateText}" MinWidth="70" MinHeight="0" Padding="6,2" FontSize="12.5" FontWeight="SemiBold"
                         CornerRadius="8" VerticalAlignment="Center" TextInputOptions.ContentType="Number" />
              </StackPanel>
              </StackPanel>
          </Grid>
          <StackPanel HorizontalAlignment="Center" Spacing="2" IsVisible="{Binding !NeedsRate}">
            <TextBlock Classes="label" Text="{l:T amount}" HorizontalAlignment="Center" />
            <TextBlock Classes="hero" Text="{Binding AmountText}" HorizontalAlignment="Center" FontSize="38" />
            <TextBlock Text="{Binding Expression}" IsVisible="{Binding ShowExpression}" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource MonoFont}" />
          </StackPanel>

          <TextBlock Classes="label" Text="{Binding FromLabel}" />
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding From}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChoiceVm">
                  <Button Classes="flat" Command="{Binding $parent[UserControl].((vm:OperationViewModel)DataContext).SelectFromCommand}" CommandParameter="{Binding}">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChoiceBody}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- debts: who -->
          <StackPanel Spacing="6" IsVisible="{Binding IsDebt}">
            <TextBlock Classes="label" Text="{l:T person}" />
            <TextBox Text="{Binding Person}" Watermark="{l:T person_hint}" CornerRadius="14" />
          </StackPanel>

          <TextBlock Classes="label" Text="{Binding ToLabel}" IsVisible="{Binding ShowTo}" />
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding ShowTo}">
            <ItemsControl ItemsSource="{Binding To}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChoiceVm">
                  <Button Classes="flat" Command="{Binding $parent[UserControl].((vm:OperationViewModel)DataContext).SelectToCommand}" CommandParameter="{Binding}">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChoiceBody}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- received amount when currencies differ -->
          <StackPanel Spacing="6" IsVisible="{Binding NeedsToAmount}">
            <TextBlock Classes="label" Text="{l:T received_amount}" />
            <TextBox Text="{Binding ToAmountText}" Watermark="{Binding ToCurrency}" CornerRadius="14" />
          </StackPanel>

          <!-- date strip -->
          <TextBlock Classes="label" Text="{l:T date}" />
          <ItemsControl ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DayVm">
                <Button Classes="flat" Margin="2" Command="{Binding $parent[UserControl].((vm:OperationViewModel)DataContext).SelectDayCommand}" CommandParameter="{Binding}">
                  <Border Classes="chip" Classes.on="{Binding IsSelected}" Padding="2,8" CornerRadius="14">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="{Binding Day}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding Caption}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBox Text="{Binding Note}" Watermark="{l:T note_hint}" CornerRadius="14" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
