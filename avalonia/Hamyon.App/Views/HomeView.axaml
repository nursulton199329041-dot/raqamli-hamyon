<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Hamyon.App.Localization"
             xmlns:vm="using:Hamyon.App.ViewModels"
             xmlns:c="using:Hamyon.App.Controls"
             x:Class="Hamyon.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <UserControl.Styles>
    <!-- drag & drop feedback: the dragged tile fades, a valid target grows with a ring -->
    <Style Selector="Button.tile">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.tile.dragSource"><Setter Property="Opacity" Value="0.35" /></Style>
    <Style Selector="Button.tile.dropTarget"><Setter Property="RenderTransform" Value="scale(1.14)" /></Style>
    <Style Selector="Button.tile.dropTarget Border.ring"><Setter Property="IsVisible" Value="True" /></Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <!-- round coloured badge + name + period amount -->
    <DataTemplate x:Key="Tile" x:DataType="vm:TileVm">
      <Button Classes="flat tile" Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenTileCommand}" CommandParameter="{Binding}">
      <StackPanel Width="84" Spacing="6" Margin="0,4">
        <Panel Width="62" Height="62" HorizontalAlignment="Center">
          <Border Width="54" Height="54" CornerRadius="27"
                  Background="{Binding Color, Converter={StaticResource BadgeBrush}}"
                  BoxShadow="{Binding Color, Converter={StaticResource Glow}}">
            <c:Glyph Kind="{Binding Icon}" Foreground="White" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Border Classes="ring" IsVisible="False" CornerRadius="31" BorderThickness="2.5" BorderBrush="{DynamicResource AccentBrush}" />
        </Panel>
        <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" />
        <TextBlock Text="{Binding Amount}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="Bold"
                   Classes.neg="{Binding Negative}">
          <TextBlock.Styles>
            <Style Selector="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Style>
            <Style Selector="TextBlock.neg"><Setter Property="Foreground" Value="{StaticResource ExpenseBrush}" /></Style>
          </TextBlock.Styles>
        </TextBlock>
      </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Panel>
  <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,12,16,120" Spacing="14" MaxWidth="560">

      <!-- header: profile avatar | mono title + profile name | profile switcher (both open the profiles sheet) -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="flat" Command="{Binding ShowProfilesCommand}">
          <Border Width="44" Height="44" CornerRadius="22" Background="{Binding ProfileColor, Converter={StaticResource HexBrush}}">
            <TextBlock Text="{Binding ProfileInitial}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{Binding $parent[Border].Background, Converter={StaticResource InkOn}}" />
          </Border>
        </Button>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="label" Text="{l:T app}" Foreground="{StaticResource TextBrush}" FontSize="13.5" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding ProfileName}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                     IsVisible="{Binding ProfileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="flat" Command="{Binding ShowProfilesCommand}">
          <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource GlassBrush}"
                  BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
            <c:Glyph Kind="users" Foreground="{StaticResource TextBrush}" Width="20" Height="20" />
          </Border>
        </Button>
      </Grid>
      <Border Height="1" Background="{StaticResource GlassBorderBrush}" />

      <!-- hero -->
      <StackPanel Spacing="14" HorizontalAlignment="Center" Margin="0,22,0,16" IsVisible="{Binding ShowBalance}">
        <TextBlock Classes="label" Text="{l:T total_balance}" HorizontalAlignment="Center" />
        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Center">
          <ItemsControl ItemsSource="{Binding Balance}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BalanceLine">
                <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" Classes.hero="{Binding Primary}" Classes.sub="{Binding !Primary}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Grid.Column="1" Classes="flat" Command="{Binding ToggleBalanceCommand}" VerticalAlignment="Top" Margin="12,10,0,0">
            <Panel>
              <c:Glyph Kind="eyeOff" Foreground="{StaticResource TextBrush}" Width="26" Height="26" IsVisible="{Binding !HideBalance}" />
              <c:Glyph Kind="eye" Foreground="{StaticResource TextBrush}" Width="26" Height="26" IsVisible="{Binding HideBalance}" />
            </Panel>
          </Button>
        </Grid>
        <Button Classes="flat" HorizontalAlignment="Center" Command="{Binding NextPeriodCommand}">
          <Border CornerRadius="22" Height="44" Padding="20,0" Background="{StaticResource GlassStrongBrush}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Classes="label" Text="{Binding PeriodLabel}" Foreground="{StaticResource TextBrush}" FontSize="13" VerticalAlignment="Center" />
              <c:Glyph Kind="chevronDown" Foreground="{StaticResource TextSecondaryBrush}" Width="12" Height="12" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Button>
      </StackPanel>

      <!-- income sources -->
      <Border Classes="card" IsVisible="{Binding ShowSources}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="{l:T income_sources}" />
            <TextBlock Grid.Column="1" Text="{Binding SourcesTotal}" FontWeight="SemiBold" Foreground="{StaticResource IncomeBrush}" />
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource Tile}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <!-- debts (only while something is open); tap opens the debts page -->
      <Button Classes="flat" Command="{Binding ShowDebtsCommand}" IsVisible="{Binding DebtsVisible}">
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="40" Height="40" CornerRadius="20" Background="#F5A524">
              <c:Glyph Kind="handshake" Foreground="White" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0" Spacing="3" VerticalAlignment="Center">
              <TextBlock Classes="label" Text="{l:T debts_card}" />
              <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource IncomeBrush}">
                <Run Text="{l:T owed_to_me}" /><Run Text=": " /><Run Text="{Binding OwedToMe}" FontWeight="Bold" />
              </TextBlock>
              <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource ExpenseBrush}">
                <Run Text="{l:T i_owe}" /><Run Text=": " /><Run Text="{Binding IOwe}" FontWeight="Bold" />
              </TextBlock>
            </StackPanel>
            <c:Glyph Grid.Column="2" Kind="chevronRight" Foreground="{StaticResource TextSecondaryBrush}" Width="18" Height="18" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Button>

      <!-- wallets -->
      <Border Classes="card" IsVisible="{Binding ShowWallets}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="{l:T wallets}" />
            <TextBlock Grid.Column="1" Text="{Binding WalletsTotal}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Wallets}" ItemTemplate="{StaticResource Tile}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <!-- expense categories (wrapping grid) -->
      <Border Classes="card" IsVisible="{Binding ShowCategories}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="{l:T expense_categories}" />
            <TextBlock Grid.Column="1" Text="{Binding CategoriesTotal}" FontWeight="SemiBold" Foreground="{StaticResource ExpenseBrush}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource Tile}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
  <!-- the floating copy of the dragged tile lives here, above everything, ignoring input -->
  <Canvas x:Name="DragLayer" IsHitTestVisible="False" />
  </Panel>
</UserControl>
