<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Hamyon.App.Localization"
             xmlns:vm="using:Hamyon.App.ViewModels"
             xmlns:c="using:Hamyon.App.Controls"
             x:Class="Hamyon.App.Views.AccountView"
             x:DataType="vm:AccountViewModel">
  <Border Background="{DynamicResource SheetBrush}" CornerRadius="30,30,0,0" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1,1,1,0"
          BoxShadow="0 -12 40 0 #80000000">
    <StackPanel Margin="18,10,18,22" Spacing="12">
      <Border Width="40" Height="5" CornerRadius="3" Background="#33FFECE4" HorizontalAlignment="Center" />
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="42" Height="42" CornerRadius="21" Background="{c:Tint '#0EA5E9'}">
          <c:Glyph Kind="user" Foreground="White" Width="20" Height="20" />
        </Border>
        <TextBlock Grid.Column="1" Margin="12,0" Classes="label" Text="{l:T acct_title}" Foreground="{StaticResource TextBrush}" FontSize="13.5" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="flat" Command="{Binding CloseCommand}">
          <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource GlassStrongBrush}">
            <c:Glyph Kind="close" Foreground="{StaticResource TextBrush}" Width="18" Height="18" />
          </Border>
        </Button>
      </Grid>

      <!-- signed out: email + password (+ name when signing up) -->
      <StackPanel Spacing="10" IsVisible="{Binding !SignedIn}">
        <TextBlock Text="{Binding Notice}" IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{StaticResource IncomeBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{l:T acct_intro}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
        <StackPanel Spacing="6" IsVisible="{Binding RegisterMode}">
          <TextBlock Classes="label" Text="{l:T name}" />
          <TextBox Text="{Binding Name}" CornerRadius="14" FontSize="16" />
        </StackPanel>
        <TextBlock Classes="label" Text="{l:T acct_email}" />
        <TextBox Text="{Binding Email}" Watermark="you@example.com" CornerRadius="14" FontSize="16" />
        <TextBlock Classes="label" Text="{l:T acct_password}" />
        <TextBox Text="{Binding Password}" PasswordChar="•" Watermark="{l:T acct_password_hint}" CornerRadius="14" FontSize="16" />
        <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{StaticResource ExpenseBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <Button Classes="flat" Command="{Binding SubmitCommand}" IsEnabled="{Binding !Busy}">
          <Border Height="54" CornerRadius="27" Background="{DynamicResource ActionBrush}">
            <TextBlock Classes="label" Text="{Binding SubmitText}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{Binding $parent[Border].Background, Converter={StaticResource InkOn}}" />
          </Border>
        </Button>
        <Button Classes="flat" Command="{Binding SwitchCommand}" HorizontalAlignment="Center">
          <TextBlock Text="{Binding SwitchText}" Foreground="{DynamicResource AccentBrush}" FontSize="14" Padding="8" Background="Transparent" />
        </Button>
      </StackPanel>

      <!-- signed in: who, sync state, sync now, sign out -->
      <StackPanel Spacing="12" IsVisible="{Binding SignedIn}">
        <Border Classes="card" Padding="14">
          <StackPanel Spacing="4">
            <TextBlock Text="{l:T acct_signed_in_as}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding AccountEmail}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{StaticResource IncomeBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Button Classes="flat" Command="{Binding SyncNowCommand}">
          <Border Height="52" CornerRadius="26" Background="{DynamicResource ActionBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
              <c:Glyph Kind="swap" Width="18" Height="18" Thickness="2.2" Foreground="{Binding $parent[Border].Background, Converter={StaticResource InkOn}}" />
              <TextBlock Classes="label" Text="{l:T acct_sync_now}" FontWeight="Bold" FontSize="14"
                         Foreground="{Binding $parent[Border].Background, Converter={StaticResource InkOn}}" />
            </StackPanel>
          </Border>
        </Button>
        <Button Classes="flat" Command="{Binding SignOutCommand}">
          <Border CornerRadius="22" Padding="12" Background="#26FF6B6B" BorderBrush="{StaticResource ExpenseBrush}" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="{l:T acct_sign_out}" Foreground="{StaticResource ExpenseBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="{l:T acct_sign_out_hint}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Border>
        </Button>

        <!-- delete the account: a quiet link, then a clear confirmation -->
        <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{StaticResource ExpenseBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <Button Classes="flat" Command="{Binding AskDeleteCommand}" HorizontalAlignment="Center" IsVisible="{Binding !ConfirmDelete}">
          <TextBlock Text="{l:T acct_delete}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Padding="8" TextDecorations="Underline" Background="Transparent" />
        </Button>
        <Border IsVisible="{Binding ConfirmDelete}" CornerRadius="18" Padding="14" Background="#26FF6B6B" BorderBrush="{StaticResource ExpenseBrush}" BorderThickness="1">
          <StackPanel Spacing="10">
            <TextBlock Text="{l:T acct_delete_warn}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" FontSize="13.5" />
            <Grid ColumnDefinitions="*,10,*">
              <Button Classes="flat" Command="{Binding AskDeleteCommand}">
                <Border Height="44" CornerRadius="22" Background="{StaticResource GlassStrongBrush}">
                  <TextBlock Text="{l:T cancel}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Button>
              <Button Grid.Column="2" Classes="flat" Command="{Binding DeleteAccountCommand}" IsEnabled="{Binding !Busy}">
                <Border Height="44" CornerRadius="22" Background="{StaticResource ExpenseBrush}">
                  <TextBlock Text="{l:T acct_delete_yes}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
