<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Hamyon.App.Localization"
             xmlns:vm="using:Hamyon.App.ViewModels"
             xmlns:c="using:Hamyon.App.Controls"
             x:Class="Hamyon.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,12,16,120" Spacing="12" MaxWidth="600">

      <TextBlock Classes="label" Text="{l:T tab_history}" Foreground="{StaticResource TextBrush}" FontSize="13.5" HorizontalAlignment="Center" Margin="0,12,0,0" />

      <!-- search -->
      <Border CornerRadius="22" Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Padding="14,0">
        <Grid ColumnDefinitions="Auto,*">
          <c:Glyph Kind="search" Foreground="{StaticResource TextSecondaryBrush}" Width="18" Height="18" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding Search}" Watermark="{l:T search}" Background="Transparent" BorderThickness="0" Margin="6,0,0,0" />
        </Grid>
      </Border>

      <!-- month switcher -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="flat" Command="{Binding PrevMonthCommand}">
          <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource GlassBrush}">
            <c:Glyph Kind="chevronLeft" Foreground="{DynamicResource AccentBrush}" Width="20" Height="20" />
          </Border>
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding MonthTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="flat" Command="{Binding NextMonthCommand}" IsVisible="{Binding CanGoNext}">
          <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource GlassBrush}">
            <c:Glyph Kind="chevronRight" Foreground="{DynamicResource AccentBrush}" Width="20" Height="20" />
          </Border>
        </Button>
      </Grid>

      <!-- saldo + in / out -->
      <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="0,6">
        <TextBlock Classes="label" Text="{l:T saldo}" HorizontalAlignment="Center" />
        <TextBlock Classes="hero" Text="{Binding Saldo}" FontSize="34" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
      <Grid ColumnDefinitions="*,10,*">
        <Border Classes="card" CornerRadius="20" Padding="14,12">
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{l:T incomes}" FontSize="11" />
            <TextBlock Text="{Binding Income}" FontWeight="Bold" Foreground="{StaticResource IncomeBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card" CornerRadius="20" Padding="14,12">
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{l:T expenses}" FontSize="11" />
            <TextBlock Text="{Binding Expense}" FontWeight="Bold" Foreground="{StaticResource ExpenseBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <TextBlock Text="{l:T no_ops_month}" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" Margin="0,40"
                 Foreground="{StaticResource TextSecondaryBrush}" />

      <!-- days -->
      <ItemsControl ItemsSource="{Binding Days}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DayGroupVm">
            <StackPanel Spacing="6" Margin="0,6">
              <Grid ColumnDefinitions="*,Auto" Margin="4,0">
                <TextBlock Classes="label" Text="{Binding Title}" />
                <TextBlock Grid.Column="1" Text="{Binding Net}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
              </Grid>
              <Border Classes="card" Padding="6" CornerRadius="22">
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryRowVm">
                      <StackPanel>
                        <Button Classes="flat" Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).ToggleCommand}" CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,8" Background="Transparent">
                            <Border Width="40" Height="40" CornerRadius="20" Background="{Binding Color, Converter={StaticResource BadgeBrush}}">
                              <c:Glyph Kind="{Binding Icon}" Foreground="White" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="12" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Amount}" FontWeight="Bold" VerticalAlignment="Center" Classes.inc="{Binding IsIncome}" Classes.exp="{Binding IsExpense}">
                              <TextBlock.Styles>
                                <Style Selector="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Style>
                                <Style Selector="TextBlock.inc"><Setter Property="Foreground" Value="{StaticResource IncomeBrush}" /></Style>
                                <Style Selector="TextBlock.exp"><Setter Property="Foreground" Value="{StaticResource ExpenseBrush}" /></Style>
                              </TextBlock.Styles>
                            </TextBlock>
                          </Grid>
                        </Button>
                        <!-- actions -->
                        <Button Classes="flat" IsVisible="{Binding IsOpen}" Margin="6,0,6,8"
                                Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}">
                          <Border Height="42" CornerRadius="21" Background="#33FF6B6B" BorderBrush="{StaticResource ExpenseBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                              <c:Glyph Kind="trash" Foreground="{StaticResource ExpenseBrush}" Width="18" Height="18" />
                              <TextBlock Classes="label" Text="{l:T delete}" Foreground="{StaticResource ExpenseBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                          </Border>
                        </Button>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
