<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>uz.raqamlinazorat.hamyon</ApplicationId>
    <ApplicationTitle>Raqamli Hamyon</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormat>
    <AndroidPackageFormat Condition="'$(Configuration)' != 'Release'">apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <!-- Play upload key: kept OUTSIDE the repo; the password comes from the HAMYON_KS_PASS environment variable.
       Without the key file a Release build is signed with the debug key (fine for installing the APK by hand). -->
  <PropertyGroup>
    <HamyonKeyStore>$(USERPROFILE)\.android\raqamli-hamyon-upload.jks</HamyonKeyStore>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And Exists('$(HamyonKeyStore)')">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(HamyonKeyStore)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>hamyon</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:HAMYON_KS_PASS</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:HAMYON_KS_PASS</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <PackageReference Include="Xamarin.AndroidX.Biometric" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hamyon.App\Hamyon.App.csproj" />
  </ItemGroup>
</Project>
