# Copy to .env and fill in. .env is git-ignored.
POSTGRES_PASSWORD=change-me-strong-password
# At least 32 characters, random. Example generator: openssl rand -base64 48
JWT_SECRET=
# Production behind HTTPS reverse proxy; Development enables Swagger + optional demo seed.
ASPNETCORE_ENVIRONMENT=Production
CORS_ORIGIN=http://localhost:8080
# Demo data works ONLY when ASPNETCORE_ENVIRONMENT=Development.
DEMO_SEED=false
DEMO_PASSWORD=
